{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "overbridge.yml",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": {
    "^x-[A-Za-z0-9]": {
      "description": "Extension settings, kept as written and never read by overbridge. Read one with `overbridge config get x-<name>.<key>`."
    }
  },
  "properties": {
    "version": { "const": 1 },
    "project-management": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "project"],
      "properties": {
        "name": { "enum": ["github", "jira"] },
        "project": { "type": ["string", "integer"], "minLength": 1 },
        "url": { "type": "string", "minLength": 1 },
        "tech-debt": { "type": ["string", "integer"], "minLength": 1 },
        "branch": {
          "type": "string",
          "minLength": 1,
          "description": "Branch name template: {id}, {number}, {slug}, {type}. Must use {id} or {number}."
        },
        "workspace": {
          "type": "string",
          "minLength": 1,
          "description": "Workspace name template: {id}, {number}, {repo}. Must use {id} or {number}."
        },
        "branch-types": {
          "type": "object",
          "description": "Item type (a Jira issue type or a GitHub label) to the {type} of a branch name; 'default' covers the rest.",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "issue-type": { "type": "string", "minLength": 1, "description": "Issue type for new items (Jira). Default: Task." }
      }
    },
    "apps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "start"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string" },
          "dir": { "type": "string" },
          "start": { "type": "string", "minLength": 1 },
          "stop": { "type": ["string", "null"] },
          "prepare": { "type": "string" },
          "ports": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 1, "maximum": 65535 } },
          "ready": {
            "type": "object",
            "additionalProperties": false,
            "oneOf": [{ "required": ["http"] }, { "required": ["tcp"] }],
            "properties": {
              "http": { "type": "string", "minLength": 1 },
              "tcp": { "oneOf": [{ "const": "{port}" }, { "type": "integer", "minimum": 1, "maximum": 65535 }] }
            }
          },
          "open": { "type": "boolean" },
          "when": { "enum": ["always", "feature-branch"] }
        }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lint": { "type": "string", "minLength": 1 },
        "typecheck": { "type": "string", "minLength": 1 },
        "test": { "type": "string", "minLength": 1 },
        "build": { "type": "string", "minLength": 1 },
        "format": { "type": "string", "minLength": 1 }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "personas": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "exclude": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "local-dir": { "type": "string", "minLength": 1 }
      }
    },
    "ide": { "enum": ["vscode", "zed", "webstorm"] }
  }
}
