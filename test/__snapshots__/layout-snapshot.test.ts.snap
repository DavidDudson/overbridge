// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`generated layout two workspaces, one resuming 1`] = `
"layout {
  default_tab_template {
    children
    pane size=1 borderless=true {
      plugin location="zellij:status-bar"
    }
  }
  tab name="@root" focus=true {
    pane split_direction="vertical" {
      pane name="sidebar" command="overbridge" cwd="/ws-root" size=60 borderless=true focus=true {
        args "sidebar" "--ws" "@root"
      }
      pane name="@root · claude" command="overbridge" cwd="/ws-root" {
        args "claude" "@root"
      }
    }
  }
  tab name="@work" {
    pane split_direction="vertical" {
      pane name="sidebar" command="overbridge" cwd="/ws-root" size=60 borderless=true focus=true {
        args "sidebar" "--ws" "@work"
      }
      pane name="@work · worklist" command="overbridge" cwd="/ws-root" {
        args "worklist"
      }
    }
  }
  tab name="ws1" {
    pane split_direction="vertical" {
      pane name="sidebar" command="overbridge" cwd="/ws-root/ws1" size=60 borderless=true focus=true {
        args "sidebar" "--ws" "ws1"
      }
      pane split_direction="horizontal" {
        pane name="top" command="overbridge" cwd="/ws-root/ws1" size=5 borderless=true {
          args "top" "--ws" "ws1"
        }
        pane name="ws1 · claude" command="overbridge" cwd="/ws-root/ws1" {
          args "claude" "ws1"
        }
      }
    }
  }
  tab name="ws2" {
    pane split_direction="vertical" {
      pane name="sidebar" command="overbridge" cwd="/ws-root/ws2" size=60 borderless=true focus=true {
        args "sidebar" "--ws" "ws2"
      }
      pane split_direction="horizontal" {
        pane name="top" command="overbridge" cwd="/ws-root/ws2" size=5 borderless=true {
          args "top" "--ws" "ws2"
        }
        pane name="ws2 · claude" command="overbridge" cwd="/ws-root/ws2" {
          args "claude" "ws2" "--continue"
        }
      }
    }
  }
}
"
`;

