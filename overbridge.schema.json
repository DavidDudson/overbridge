{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "overbridge.yml",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": {
    "^x-[A-Za-z0-9]": {
      "description": "Extension settings, kept as written and never read by overbridge. Read one with `overbridge config get x-<name>.<key>`."
    }
  },
  "properties": {
    "version": { "const": 1 },
    "project-management": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "project"],
      "properties": {
        "name": { "enum": ["github", "jira"] },
        "project": { "type": ["string", "integer"], "minLength": 1 },
        "url": { "type": "string", "minLength": 1 },
        "tech-debt": { "type": ["string", "integer"], "minLength": 1 },
        "branch": {
          "type": "string",
          "minLength": 1,
          "description": "Branch name template: {id}, {number}, {slug}, {type}. Must use {id} or {number}."
        },
        "workspace": {
          "type": "string",
          "minLength": 1,
          "description": "Workspace name template: {id}, {number}, {repo}. Must use {id} or {number}."
        },
        "branch-types": {
          "type": "object",
          "description": "Item type (a Jira issue type or a GitHub label) to the {type} of a branch name; 'default' covers the rest.",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "issue-type": { "type": "string", "minLength": 1, "description": "Issue type for new items (Jira). Default: Task." },
        "worklist-jql": {
          "type": "string",
          "description": "Jira only: JQL that narrows the work list to some of your open tickets. Default: (sprint in openSprints() OR statusCategory = \"In Progress\"). Empty lists every open ticket."
        }
      }
    },
    "apps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "start"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string" },
          "dir": { "type": "string" },
          "start": { "type": "string", "minLength": 1 },
          "stop": { "type": ["string", "null"] },
          "prepare": { "type": "string" },
          "ports": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 1, "maximum": 65535 } },
          "ready": {
            "type": "object",
            "additionalProperties": false,
            "oneOf": [{ "required": ["http"] }, { "required": ["tcp"] }],
            "properties": {
              "http": { "type": "string", "minLength": 1 },
              "tcp": { "oneOf": [{ "const": "{port}" }, { "type": "integer", "minimum": 1, "maximum": 65535 }] }
            }
          },
          "open": { "type": "boolean" },
          "when": { "enum": ["always", "feature-branch"] }
        }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lint": { "type": "string", "minLength": 1 },
        "typecheck": { "type": "string", "minLength": 1 },
        "test": { "type": "string", "minLength": 1 },
        "build": { "type": "string", "minLength": 1 },
        "format": { "type": "string", "minLength": 1 }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "personas": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "exclude": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "local-dir": { "type": "string", "minLength": 1 }
      }
    },
    "ide": { "enum": ["vscode", "zed", "webstorm"] },
    "shell": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["enter"],
          "properties": {
            "enter": { "type": "string", "minLength": 1 },
            "env": { "type": "string", "minLength": 1 },
            "key": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          },
          "dependentRequired": { "key": ["env"] }
        }
      ]
    },
    "icebox": {
      "description": "What `overbridge icebox --prune` may delete. Every key is optional.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prune": {
          "description": "Repo-relative paths removed by `icebox --prune`, such as node_modules or target. Only paths git ignores and does not track are deleted; no `..`, absolute paths, globs, `.git` or `.claude`.",
          "type": "array",
          "items": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!\\.git(/|$))(?!\\.claude(/|$))(?!.*(^|/)\\.\\.(/|$))[^*?\\[\\\\:]+$" }
        }
      }
    },
    "check-queue": {
      "description": "How `overbridge check` queues a command. Every key is optional.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max-load-percent": {
          "description": "Start a run only while the 1-minute load average is under this share of the cores. Over 100 allows more load than there are cores. Default 70.",
          "type": "integer",
          "minimum": 1
        },
        "max-parallel": {
          "description": "Run at most this many commands at once. Unset leaves the load as the only limit; 1 runs them one at a time.",
          "type": "integer",
          "minimum": 1
        },
        "timeout-seconds": { "description": "Kill the run after this long. Default 180.", "type": "integer", "minimum": 1 },
        "stall-seconds": {
          "description": "Kill the run once its processes have used no CPU for this long. Default 300.",
          "type": "integer",
          "minimum": 1
        },
        "wait-seconds": { "description": "Give up waiting for a turn after this long. Default 900.", "type": "integer", "minimum": 1 }
      }
    }
  }
}
