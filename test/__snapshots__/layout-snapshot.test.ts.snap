// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`generated layout two workspaces, one resuming 1`] = `
"layout {
  default_tab_template {
    children
    pane size=1 borderless=true {
      plugin location="zellij:status-bar"
    }
  }
  tab name="ws1" focus=true {
    pane split_direction="vertical" {
      pane name="sidebar" command="overbridge" cwd="/ws-root/ws1" size=28 borderless=true focus=true {
        args "sidebar" "--ws" "ws1"
      }
      pane split_direction="horizontal" {
        pane name="top" command="overbridge" cwd="/ws-root/ws1" size=4 borderless=true {
          args "top" "--ws" "ws1"
        }
        pane name="ws1 · claude" command="overbridge" cwd="/ws-root/ws1" size="65%" {
          args "claude" "ws1"
        }
        pane name="ws1 · shell" cwd="/ws-root/ws1"
      }
    }
  }
  tab name="ws2" {
    pane split_direction="vertical" {
      pane name="sidebar" command="overbridge" cwd="/ws-root/ws2" size=28 borderless=true focus=true {
        args "sidebar" "--ws" "ws2"
      }
      pane split_direction="horizontal" {
        pane name="top" command="overbridge" cwd="/ws-root/ws2" size=4 borderless=true {
          args "top" "--ws" "ws2"
        }
        pane name="ws2 · claude" command="overbridge" cwd="/ws-root/ws2" size="65%" {
          args "claude" "ws2" "--continue"
        }
        pane name="ws2 · shell" cwd="/ws-root/ws2"
      }
    }
  }
}
"
`;

exports[`generated layout a wide sidebar and a self command with arguments 1`] = `
"layout {
  default_tab_template {
    children
    pane size=1 borderless=true {
      plugin location="zellij:status-bar"
    }
  }
  tab name="ws1" focus=true {
    pane split_direction="vertical" {
      pane name="sidebar" command="/usr/bin/bun" cwd="/ws-root/ws1" size=40 borderless=true focus=true {
        args "/opt/overbridge/src/cli.ts" "sidebar" "--ws" "ws1"
      }
      pane split_direction="horizontal" {
        pane name="top" command="/usr/bin/bun" cwd="/ws-root/ws1" size=4 borderless=true {
          args "/opt/overbridge/src/cli.ts" "top" "--ws" "ws1"
        }
        pane name="ws1 · claude" command="/usr/bin/bun" cwd="/ws-root/ws1" size="65%" {
          args "/opt/overbridge/src/cli.ts" "claude" "ws1"
        }
        pane name="ws1 · shell" cwd="/ws-root/ws1"
      }
    }
  }
}
"
`;
